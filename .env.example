# Facebook OAuth — copia este archivo a .env y rellena los valores.
# NUNCA pongas FACEBOOK_APP_SECRET aqui. El secreto vive solo en el servidor.

# App ID de tu app en developers.facebook.com
VITE_FB_APP_ID=

# URI de redireccion registrada en la app de Facebook
# En local: http://localhost:5173/conectar/callback
# En produccion: https://tu-dominio.com/conectar/callback
VITE_FB_REDIRECT_URI=http://localhost:5173/conectar/callback
