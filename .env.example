# Copia este archivo a .env y rellena los valores.
# NUNCA subas .env a git. El App Secret queda SOLO en el servidor.

# --- Frontend (Vite) ---
VITE_FB_APP_ID=
VITE_FB_REDIRECT_URI=http://localhost:8080/conectar/callback

# --- Backend / servidor local (server/index.mjs) ---
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=http://localhost:8080/conectar/callback
SERVER_PORT=8787
