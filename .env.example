# Copia este archivo a .env y rellena los valores.
# NUNCA subas .env a git. El App Secret queda SOLO en el servidor.

# --- Frontend (Vite) ---
VITE_FB_APP_ID=
VITE_FB_REDIRECT_URI=http://localhost:8080/conectar/callback

# --- Backend / servidor local (server/index.mjs) ---
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=http://localhost:8080/conectar/callback
SERVER_PORT=8787

# --- Webhook ---
# Token que tú eliges; debe coincidir con lo que registras en Meta Webhooks
FB_VERIFY_TOKEN=mi_token_secreto_webhook
# URL pública de tu servidor (ej. ngrok). Solo para referencia — no la usa el código
PUBLIC_WEBHOOK_URL=https://xxxx.ngrok-free.app/api/facebook/webhook

# --- Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
